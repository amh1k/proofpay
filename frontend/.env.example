# ProofPay web app.
#
# Mocks are ON by default, so a fresh clone runs with no backend. The payloads in
# src/mocks/ are generated from the real verification engine.
#
# Set this to false to hit the live API instead. Sign-in is automatic:
# POST /api/v1/auth/token (form-encoded, user `owner`, any password), then Bearer.
# The dev server proxies /api to http://127.0.0.1:8000 — see vite.config.ts.
VITE_USE_MOCKS=true
