# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environment
.env
.env.local

# Local data
*.db
*.sqlite3
storage/
backend/storage/
# Track B's Python storage adapter is source code, not runtime data.
!backend/proofpay/storage/
!backend/proofpay/storage/**
# ...but re-exclude bytecode, which the line above would otherwise drag back in.
# A negation re-includes EVERYTHING under the path, so the `__pycache__/` rule at
# the top of this file stops applying inside it — which is how five .pyc files
# came to be committed here.
backend/proofpay/storage/__pycache__/

# Node
node_modules/
dist/
.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Reference clones and local design scratch — never commit these.
# They live outside the repo, but this is a second line of defence.
_reference/
reference/
shots/
*.local.html
