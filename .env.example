# ProofPay configuration
# Copy to .env and fill in. Every value below has a working default,
# so the application runs with no .env at all.

PROOFPAY_ENV=development
PROOFPAY_SECRET_KEY=dev-insecure-change-me

# Relational storage. SQLite for local dev; swap for ApsaraDB RDS / PostgreSQL.
# PROOFPAY_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/proofpay
PROOFPAY_DATABASE_URL=sqlite:///./proofpay.db

# Private object storage for proof images.
# backend: "local" | "oss"
PROOFPAY_STORAGE_BACKEND=local
PROOFPAY_STORAGE_LOCAL_PATH=./storage

# Alibaba Cloud OSS (used when PROOFPAY_STORAGE_BACKEND=oss)
# PROOFPAY_OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
# PROOFPAY_OSS_BUCKET=proofpay-proofs
# PROOFPAY_OSS_ACCESS_KEY_ID=
# PROOFPAY_OSS_ACCESS_KEY_SECRET=

# Receipt understanding.
# extractor: "qwen" | "deterministic"
# Falls back to "deterministic" automatically when no API key is present,
# so the demo never breaks on a missing credential.
PROOFPAY_RECEIPT_EXTRACTOR=deterministic
PROOFPAY_QWEN_MODEL=qwen-vl-max
# PROOFPAY_DASHSCOPE_API_KEY=

# Upload limits
PROOFPAY_MAX_UPLOAD_BYTES=8388608
